// main.lust
// Lust Valley: a tiny farming game.
// Run it with: lust run examples/valley/main.lust

fetch crops;
fetch shop:Shop;

state season = [spring, summer, fall, winter];

object Farm {
    has {
        int[gold 30, day 1, goal 300];
        Crop array field [];
        season is spring;
    }

    method show() {
        is #field 0? then {
            print("  Your field is empty. Buy some seeds!");
            give;
        }
        int spot = 1;
        loop (Crop c in field) {
            print("  " + spot.text() + ". " + c:describe());
            spot = spot + 1;
        }
    }

    method buy() {
        Shop:list();
        string answer = ask("  Which seeds? (number, or nothing to go back)");
        is answer ""? then { give; }
        is answer.isNumber() not true? then {
            print("  The shopkeeper squints at you.");
            give;
        }
        int id = answer.int();
        is Shop:sells(id) not true? then {
            print("  The shop doesn't have that.");
            give;
        }
        is Shop:cost(id) > gold? then {
            print("  You can't afford that.");
            give;
        }
        gold = gold - Shop:cost(id);
        field:inject(seedFor(Shop:seed(id)));
        print("  You plant some " + Shop:seed(id) + " seeds.");
    }

    method water() {
        loop (Crop c in field) {
            c.watered = true;
        }
        print("  Splish splash. Everything is watered.");
    }

    method harvest() {
        Crop array left = [];
        int earned = 0;
        loop (Crop c in field) {
            is c.state ripe? then {
                earned = earned + c.price;
            } or {
                left:inject(c);
            }
        }
        field = left;
        gold = gold + earned;
        print(either earned > 0? "  You sold your harvest for " + earned.text() + "g!" or "  Nothing is ripe yet.");
    }

    method sleep() {
        print("  You sleep...");
        loop (Crop c in field) {
            c:grow();
        }
        day = day + 1;
        is day % 7 1? then {
            nextSeason();
        }
    }

    method nextSeason() {
        is season spring? then { season is summer; }
        or is season summer? then { season is fall; }
        or is season fall? then { season is winter; }
        or { season is spring; }
        print("  It's " + season.text() + " now.");
        is season winter? then {
            loop (Crop c in field) {
                c.state is withered;
            }
            print("  Winter frost! Everything in the field withered.");
        }
    }
}

print("Welcome to Lust Valley!");
string name = ask("What's your farmer's name?");
is name ""? then {
    name = "Farmer";
}
print("Hi " + name + ". Save up " + Farm.goal.text() + "g to buy a tractor!");

truth playing = true;
loop (playing) {
    print("");
    print("Day " + Farm.day.text() + ", " + Farm.season.text() + ". " + name + " has " + Farm.gold.text() + "g.");
    Farm:show();
    string choice = ask("[b]uy  [w]ater  [h]arvest  [s]leep  [q]uit >");

    is choice "b"? then {
        Farm:buy();
    } or is choice "w"? then {
        Farm:water();
    } or is choice "h"? then {
        Farm:harvest();
    } or is choice "s"? then {
        Farm:sleep();
    } or is choice "q" || choice ""? then {
        playing = not true;
    } or {
        print("  Hmm? Try b, w, h, s or q.");
    }

    is Farm.gold >= Farm.goal? then {
        print("");
        print("You saved " + Farm.gold.text() + "g and bought a shiny tractor. You win, " + name + "!");
        playing = not true;
    }
}

print("Thanks for farming! " + name + " ended day " + Farm.day.text() + " with " + Farm.gold.text() + "g.");

end
