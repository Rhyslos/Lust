// crops.lust
// Everything that grows in Lust Valley.

state = [seed, sprout, ripe, withered];

class Crop {
    has {
        string[name "turnip"];
        int[days 0, growTime 3, price 20];
        truth[watered not true];
        state is seed;
    }

    // One night passes.
    method grow() {
        is state ripe || state withered? then {
            give;
        }
        is watered not true? then {
            print("  The " + name + " was thirsty and didn't grow.");
            give;
        }
        watered = not true;
        days = days + 1;
        is days >= growTime? then {
            state is ripe;
            print("  The " + name + " is ripe!");
        } or {
            state is sprout;
        }
    }

    method string describe() {
        string water = either watered? ", watered" or "";
        is state ripe? then {
            give name + " (ripe, sells for " + price.text() + "g)";
        }
        give name + " (" + state.text() + ", day " + days.text() + " of " + growTime.text() + water + ")";
    }
}

class Strawberry like Crop {
    has {
        string[name "strawberry"];
        int[growTime 2, price 14];
    }
}

class Pumpkin like Crop {
    has {
        string[name "pumpkin"];
        int[growTime 5, price 75];
    }
}

// A fresh seed of the kind the shop sells.
do Crop seedFor(string kind) {
    is kind "strawberry"? then { give new Strawberry; }
    is kind "pumpkin"? then { give new Pumpkin; }
    give new Crop;
}

send state;
send Crop;
send Strawberry;
send Pumpkin;
send seedFor;

end
