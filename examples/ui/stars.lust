// stars.lust
// Catch the falling stars with your basket: Left and Right move it, or click where it should go.
// Space starts over. It shows a canvas, a timer, keys and colours.
// Run it with: lust run examples/ui/stars.lust   (Windows only)

fetch ui;

object Game like Window {
    has {
        string[title "Catch the stars"];
        int[width 440, height 400];
        string[background "midnightblue"];
        Sky[sky nothing];
        Label[score nothing];
        int[basket 170, caught 0, missed 0];
        cArray(int x, int y, int speed) stars [];
    }

    method build() {
        score = new Label { text "Use Left and Right to catch the stars.", color "white", textSize 12 };
        add(score);
        sky = new Sky { width 400, height 320, background "black" };
        add(sky);
        startTimer(0.03);
    }

    // Runs about 30 times a second.
    method tick() {
        is isKeyDown("Left") && basket > 0? then { basket = basket - 8; }
        is isKeyDown("Right") && basket < 340? then { basket = basket + 8; }
        is random(1, 20) 1? then { stars:inject([random(10, 390), 0, random(3, 7)]); }

        loop (int id, int x, int y, int speed in stars) {
            int now = y + speed;
            stars[id].y = now;
            is now > 290 && now < 315 && x > basket && x < basket + 60? then {
                caught = caught + 1;
                stars:remove(id);
            } or is now > 320? then {
                missed = missed + 1;
                stars:remove(id);
            }
        }
        draw();
        score.text = "Caught: " + caught.text() + "    Missed: " + missed.text();
    }

    method keyPressed(string key) {
        is key "Space"? then {
            caught = 0;
            missed = 0;
        }
    }

    method draw() {
        sky:clear();
        loop (int id, int x, int y, int speed in stars) {
            sky:circle(x, y, 5, "gold");
        }
        sky:rect(basket, 300, 60, 12, "#e0115f");
    }
}

class Sky like Canvas {
    method clicked(int x, int y) {
        Game.basket = x - 30;
    }
}

Game:open();

end
