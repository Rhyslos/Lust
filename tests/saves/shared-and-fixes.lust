fetch cs:System.String;
fetch cs:System.IO.Path;
fetch cs:System.UInt64;
class Dog { has { int array tricks []; int map marks []; } }
save g = [a, b, shared];
Dog a = new Dog;
Dog b = new Dog;
int array shared = [1, 2];
b.tricks = a.tricks;
a.marks = b.marks;
a.tricks = shared;
b.tricks = shared;
save g;
load g;
is a.tricks b.tricks? then { print("same tricks"); } or { print("DIFFERENT"); }
is a.tricks shared? then { print("same as shared"); } or { print("DIFFERENT"); }
is a.marks b.marks? then { print("same marks"); } or { print("DIFFERENT"); }
Dog array one = [nothing];
print(#one);
do int inc(int n) { give n + 1; }
do do int(int) pick() { give inc; }
print(pick()(4));
int map m = ["a" -1, "b" 2];
print(m);
cArray(do() f, string n) jobs = [[1, hi, "a"]];
do hi() { print("hi from a column"); }
jobs[1]:f();
print(String:Format("{0}+{1}={2}", 1, 2, 3));
print(Path:Combine("a", "b", "c", "d", "e").Length);
print(true:ToString());
print(UInt64:Parse("5"));
print("tab\there");
string array t = ["tab\there"];
print(t);

end
