-- A small web API, tried with Web:request instead of a real browser.
schema NewUser {
    has {
        string name;
        int age = 0;
    }
}

class User {
    has {
        int id = 0;
        string name = "";
        int age = 0;
    }
}

object Users {
    has {
        User array all = [];
    }
}

method User getUser(int id) {
    loop (User u in Users.all) {
        is u.id == id? then {
            return u;
        }
    }
    Web:fail(404, "there's no user " + id.text() + ".");
    return nothing;
}

method User createUser(NewUser body) {
    User u = new User { id = #Users.all + 1, name = body.name, age = body.age };
    Users.all:inject(u);
    return u;
}

method User array listUsers() {
    return Users.all;
}

method string hello(string who) {
    return "Hello, " + who + "!";
}

method removeAll() {
    Users.all = [];
}

method int crash(int n) {
    return 10 / n;
}

route "/api" {
    get "/users" => listUsers;
    get "/users/:id" => getUser;
    post "/users" => createUser;
    delete "/users" => removeAll;
    get "/hello/:who" => hello;
    get "/crash/:n" => crash;
}

print(Web:request("POST", "/api/users", "{\"name\": \"Ada\", \"age\": 36}"));
print(Web:request("post", "/api/users", "{\"name\": \"Bo\"}"));
print(Web:request("GET", "/api/users", ""));
print(Web:request("GET", "/api/users/2", ""));
print(Web:request("GET", "/api/users/9", ""));
print(Web:request("GET", "/api/users/two", ""));
print(Web:request("GET", "/api/users/1.5", ""));
print(Web:request("GET", "/api/hello/Garry%20Newman?x=1", ""));
print(Web:request("POST", "/api/users", "{\"age\": 3}"));
print(Web:request("POST", "/api/users", "\{oops"));
print(Web:request("PUT", "/api/users", ""));
print(Web:request("GET", "/nowhere", ""));
print(Web:request("GET", "/api/crash/0", ""));
print(Web:request("DELETE", "/api/users", ""));
print(Web:request("GET", "/api/users", ""));
NewUser n = new NewUser { name = "Cy" };
print(n.age);
end
