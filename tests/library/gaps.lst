-- Random numbers, patterns, dates and sorting.
class Player {
    has {
        string name = "";
        int score = 0;
    }
}

-- Random: the values change, so only their ranges are printed.
int dice = Random[1, 6];
print(dice >= 1 && dice <= 6);
float r = Random[0.0, 1.0];
print(r >= 0.0 && r < 1.0);
float half = Random[2, 3];
print(half >= 2.0 && half < 3.0);
print(Random[5, 5]);
try {
    print(Random[6, 1]);
} error (string e) {
    print(e);
}

-- Patterns.
string line = "Order 42 shipped on 2026-10-21, order 7 on 2026-11-02";
print(line:matches("[0-9]{4}-[0-9]{2}-[0-9]{2}"));
print(line:findAll("[0-9]+-[0-9]+-[0-9]+"));
print(line:capture("Order ([0-9]+) shipped on ([0-9-]+)"));
print(line:capture("nothing like this"));
print(line:replaceAll("[0-9]+", "#"));
print("a1b22c333":replaceAll("([a-z])([0-9]+)", "$2$1"));
try {
    print(line:matches("(unclosed"));
} error (string e) {
    print(e:startsWith("\"(unclosed\" isn't a pattern Lust understands"));
}

-- Dates.
print(Time:addDays("2026-10-21", 14));
print(Time:addDays("2024-02-28", 1));
print(Time:addDays("2026-01-01", -1));
print(Time:daysBetween("2026-01-01", "2026-12-25"));
print(Time:weekday("2026-10-21"));
print(Time:weekday("1970-01-01"));
print(Time:isDate("2026-02-30"));
print(Time:isDate("2024-02-29"));
try {
    print(Time:weekday("21/10/2026"));
} error (string e) {
    print(e);
}

-- Sorting.
cMap(int id, string name, int stock) shop = [["tea", 10], ["cake", 3], ["bun", 10], ["pie", 5]];
shop:sortBy(stock);
print(shop);
shop:sortBy(name);
shop:reverse();
print(shop);
Player array team = [new Player { name = "Ada", score = 30 }, new Player { name = "Bo", score = 12 }, new Player { name = "Cy", score = 30 }];
team:sortBy(score);
loop (Player p in team) {
    print(p.name + " " + p.score.text());
}
team:sortBy(name);
team:reverse();
print(team[0].name);

-- Asking a website that isn't there.
try {
    print(Web:get("http://127.0.0.1:9/nothing"));
} error (string e) {
    print(e);
}
try {
    print(Web:get("ftp://example.com"));
} error (string e) {
    print(e);
}
end
