-- Built as a library for an engine, a method the engine calls straight into can't wait: a wait { }
-- there goes straight on when its questions are true, and otherwise stops with a message saying
-- to start a method that waits instead.
object Gate {
    has {
        bool open = false;
    }
}

method bool through() {
    wait {
        is Gate.open?
    }
    return true;
}

method openUp() {
    Gate.open = true;
}

pass through, openUp;
end
