-- Built as a library for an engine, runs aren't there yet: start gate = … just calls the method,
-- so its work is done by the next line, and cancelling it then does nothing.
method openGate() {
    print("gate opens");
}

method string tryIt() {
    start gate = openGate();
    string before = "gate is {gate.state}";
    cancel gate;
    return before + ", and still {gate.state}";
}

pass tryIt;
end
