-- Built as a library for an engine, start gate = … runs the method straight away until it waits: one
-- that never waits is done by the next line, and cancelling it then does nothing.
method openGate() {
    print("gate opens");
}

method string tryIt() {
    start gate = openGate();
    string before = "gate is {gate.state}";
    cancel gate;
    return before + ", and still {gate.state}";
}

pass tryIt;
end
