-- Game logic using an engine's vectors and lists.
fetch "engine/world":Thing;
get "engine/world":[ids, gravity, aim];

class Bot {
    has {
        vec3 velocity = [0, 0, 0];
        int steps = 0;
    }

    method step(Thing bot, float dt) {
        velocity = velocity + gravity() * dt;
        bot:moveTo(bot:position() + velocity * dt);
        steps = steps + 1;
    }

    method vec3 ahead(Thing bot) {
        return bot:facing() * [1, 0, 0];
    }

    method int crowd(Thing bot) {
        return #bot:near(5.0);
    }

    method plan(Thing bot) {
        vec3 array path = [bot:position(), bot:position() + ahead(bot) * 2];
        aim(path, bot:facing());
    }
}

method int countAll() {
    return #ids();
}

pass Bot, countAll;
end
