// Classes, objects, like, functions and nothing.
class Dog {
    has {
        string[name "Rex"];
        int[hp 10, age 3,];
        truth[hungry not true];
        Dog[friend nothing];
    }

    method bark() {
        print(name + " says woof");
    }

    method int dogYears() {
        give age * 7;
    }

    method hurt(int damage) {
        hp = hp - damage;
        is hp < 0? then { hp = 0; }
    }

    method string status() {
        give either hp > 0? name + " is fine" or name + " needs a nap";
    }
}

class Puppy like Dog {
    has {
        int[age 0];
        int[toys 2];
    }

    method bark() {
        print(name + " says yip");
    }
}

object Kennel {
    has {
        int[count 0];
        string[sign "Dogs welcome"];
    }

    method welcome(Dog d) {
        count = count + 1;
        print("Welcome, " + d.name + "! Dogs so far: " + count.text());
    }
}

do int double(int n) {
    give n * 2;
}

do string loudest(Dog a, Dog b) {
    is a.hp >= b.hp? then {
        give a.name;
    }
    give b.name;
}

do greet() {
    print("Hello from a function");
}

Dog rex = new Dog;
Dog bo = new Dog { name "Bo", hp 12 };
Puppy pip = new Puppy { name "Pip" };

rex:bark();
bo:bark();
pip:bark();
print(bo.hp);
print(rex:dogYears());
print(pip:dogYears());
print(pip.toys);

bo:hurt(5);
print(bo.hp);
bo:hurt(50);
print(bo:status());
print(rex:status());

Kennel:welcome(rex);
Kennel:welcome(pip);
print(Kennel.sign);
Kennel.count = 10;
print(Kennel.count);

print(double(21));
print(loudest(rex, bo));
greet();

// A Puppy can go where a Dog goes.
Dog any = pip;
any:bark();
is any like Puppy? then { print("any is a puppy"); }
is rex like Puppy? then { print("wrong"); } or { print("rex is not a puppy"); }
is rex not like Puppy? then { print("still not a puppy"); }

// nothing
is rex.friend nothing? then { print("rex has no friend yet"); }
rex.friend = bo;
is rex.friend not nothing? then { print("rex's friend is " + rex.friend.name); }
rex.friend.hp = 99;
print(bo.hp);

print(rex);
print(pip);
print(rex.friend);

end
