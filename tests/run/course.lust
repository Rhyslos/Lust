// Behaviour pinned down while writing the Learn Lust course.

// An int fits where a float goes, and either mixes them into a float.
float speed = 2;
print(speed);
truth hungry = true;
print(either hungry? 1 or 1.5);

// A loop's check works like a question's.
string cmd = "go";
int n = 0;
loop (cmd not "quit") {
    n = n + 1;
    is n 3? then { cmd = "quit"; }
}
print(n);

// The main state can be copied with =, inside a method too.
state = [idle, busy];
class Robot {
    has { state is idle; }
    method copy(Robot other) { state = other.state; }
}
Robot r = new Robot;
Robot q = new Robot;
q.state is busy;
r:copy(q);
print(r.state);
state s = idle;
loop (s idle) { s is busy; }
print(s);

// cArray ids are never reused, even after the biggest is removed.
cArray(string item) bag = [];
bag:inject(["a"]);
bag:inject(["b"]);
bag:remove(2);
bag:inject(["c"]);
print(bag);

// Text with a point: .isNumber() is true, and .int() drops the part after the point.
print("3.5".isNumber());
print("3.5".int());

// # reads the whole thing after it, so #bag.text() is #(bag.text()); use (#bag).text().
print((#bag).text());

// Dividing a float by zero isn't a mistake: it gives infinity.
print(1.0 / 0);

// Deep recursion that does stop is fine.
do int down(int k) {
    is k 0? then { give 0; }
    give down(k - 1) + 1;
}
print(down(100000));

end
