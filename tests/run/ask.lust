// ask reads a typed line. Text can become a number with .int() or .float().
string name = ask("What's your name?");
print("Hi " + name + "!");

string age = ask("How old are you?");
is age.isNumber()? then {
    int years = age.int();
    print("Next year you'll be " + (years + 1).text());
}

string height = ask("How tall are you, in meters?");
float h = height.float();
print(h * 100);

string nope = ask("Type anything:");
print(nope.isNumber());

// When there's nothing more to read, ask gives back "".
string empty = ask("");
print(#empty);

end
