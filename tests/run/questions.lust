// is … ? then … or, and either.
int hp = 10;
truth hungry = true;
string mood = "happy";

is hp 0? then {
    print("out cold");
} or is hp < 5? then {
    print("barely standing");
} or {
    print("fine");
}

is hp 10? then { print("exactly ten"); }
is hp not 10? then { print("wrong"); }
is hungry? then { print("hungry on its own"); }
is not hungry? then { print("wrong"); } or { print("not not hungry"); }
is hungry true && mood "happy"? then { print("both"); }
is hungry not true || hp > 5? then { print("one of them"); }
is mood not "sad"? then { print("not sad"); }
is 2.0 2? then { print("2.0 is 2"); }

int x = -1;
is x (-1)? then { print("minus one"); }

string label = either hp > 5? "strong" or "weak";
print(label);
float half = either hp > 50? 2.5 or 1;
print(half);
print(either hungry? either hp > 5? "hungry and strong" or "hungry" or "full");
truth low = hp < 5;
print(low);
truth same = either mood "happy"? true or not true;
print(same);

end
