-- Angles: asin, acos, atan, atan2, and degrees and radians, the same in Lua and Rust.
print(Maths:asin(0.5), Maths:acos(0.5), Maths:atan(1));
print(Maths:atan2(1, 1), Maths:atan2(-1, -1), Maths:atan2(0, -1));
print(Maths:degrees(Maths.pi), Maths:radians(180), Maths:degrees(Maths:atan2(1, 0)));

-- Which way something points, from where it is to where it's going.
vec3 from = [1, 1, 0];
vec3 to = [4, 5, 0];
vec3 d = to - from;
print("heading {Maths:degrees(Maths:atan2(d.y, d.x))} degrees");

-- Small numbers can be written with e now, as Lust prints them.
print(1e-7, 2.5e3, 1E+20, [1e30, 0, 0]);

try {
    print(Maths:asin(2));
} error (string message) {
    print(message);
}
end
