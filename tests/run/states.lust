// The main state and named states.
state = [idle, walking, fighting];
state season = [spring, summer, fall, winter];
state weather = [sunny, rainy];

class Farmer {
    has {
        string[name "Ada"];
        state is idle;
        season is spring;
        weather is sunny;
    }

    method nextSeason() {
        is season spring? then { season is summer; }
        or is season summer? then { season is fall; }
        or is season fall? then { season is winter; }
        or { season is spring; }
    }

    method work() {
        state is walking;
        is weather rainy? then {
            print(name + " stays inside");
            state is idle;
        }
    }
}

Farmer ada = new Farmer;
print(ada.state);
print(ada.season.text());
ada:work();
print(ada.state);
ada.weather is rainy;
ada:work();
print(ada.state);

loop 3 { ada:nextSeason(); }
print(ada.season);
is ada.season winter? then { print("nothing grows"); }
is ada.season not spring? then { print("not spring"); }

loop (season s in season) {
    print("Season: " + s.text());
}
loop (state s in state) {
    print(s);
}

season today = summer;
today is fall;
print(today);
Farmer bo = new Farmer { name "Bo", season winter };
print(bo.season);
print(bo);

end
