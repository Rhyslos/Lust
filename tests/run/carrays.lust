// cArrays: tiny tables with ids.
cArray(string itemName, int amount) bag = [
    [1, "sword", 1],
    [2, "apple", 3]
];

print(bag[2].itemName);
print(bag[1].id);
bag[2].amount = bag[2].amount - 1;
print(bag[2].amount);

bag:inject(["map", 1]);
bag:inject([10, "potion", 2]);
bag:inject(["torch", 4]);
print(#bag);

loop (int id, string itemName, int amount in bag) {
    print(id.text() + ": " + itemName + " x" + amount.text());
}

bag:remove(1);
print(bag:has(1));
print(bag:has(2));
print(bag);

// Two cArrays can both use id 1.
cArray(string itemName, int price) shop = [[1, "potion", 10]];
print(shop[1].itemName + " costs " + shop[1].price.text());

cArray(int score) empty = [];
empty:inject([7]);
print(empty[1].score);

end
