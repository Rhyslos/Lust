// The one loop, with stop and skip.
loop 3 {
    print("hip hip hooray");
}

int n = 0;
loop (n < 5) {
    n = n + 1;
    is n 2? then { skip; }
    print("n is " + n.text());
}

int tries = 0;
loop {
    tries = tries + 1;
    is tries >= 4? then { stop; }
}
print("tries: " + tries.text());

int total = 0;
loop 3 {
    loop 2 {
        total = total + 1;
    }
}
print(total);

loop 0 { print("never"); }

// Names inside a block are gone after it, so they can be used again.
loop 1 { int temp = 1; print(temp); }
loop 1 { int temp = 2; print(temp); }

int roll = random(1, 6);
is roll >= 1 && roll <= 6? then { print("roll ok"); }
int same = random(4, 4);
print(same);
wait 0;
wait 0.01;

end
