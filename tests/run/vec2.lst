-- vec2: two f32 numbers for 2D, worked out the same in Lua and Rust.
vec2 a = [3.0, 4.5];
vec2 b = [3, 4];
print(a, b);
print(a + b, a - b, b * 2, 2 * b, b / 4, -b);

-- Parts, and changing them.
print(a.x, a.y);
a.x = 7;
a.y += 0.5;
a += [1, 1];
a -= [0.5, 0.5];
a *= 2;
a /= 4;
print(a);

-- Methods.
print(b:length(), b:normalized(), b:dot([1, 2]), b:distance([0, 0]));
print(b:lerp([0, 0], 0.25), b:lerp([1, 1], 2));
print(b:angle([0, 1]), b:angle([-3, -4]), b:angle(b));

-- cross: which way the other turns from this one, above 0 to the left.
vec2 east = [1, 0];
print(east:cross([0, 1]), east:cross([0, -1]), east:cross([2, 0]), b:cross([1, 0]));

-- rotated: turned around [0, 0], counter-clockwise for more than 0. Quarter turns are exact.
print(east:rotated(90), east:rotated(180), east:rotated(270), east:rotated(360), east:rotated(-90));
print(b:rotated(-450), b:rotated(30), b:rotated(45.5), b:rotated(0.1));
vec2 at = [1.75, 1.875];
print(at:rotated(90), at:rotated(30));
print(east:rotated(1e300), east:rotated(-720));

-- Between vec2 and vec3.
vec3 p = [1, 2, 3];
print(p.xy, b:withZ(2), p.xy:withZ(p.z) == p);

-- Edges: zero, tiny and huge numbers, f32 rounding.
vec2 zero = [0, 0];
print(zero:normalized(), zero:length(), -zero);
vec2 third = [1.0 / 3.0, 0.1];
print(third, third.x, third * 3);
vec2 big = [3e38, -3e38];
print(big * 2, big / 1e-30);

-- Equality is exact.
print(a == [3.75, 2.75], a != [3.75, 2.75], a == [3.75, 2.5], third == [0.333333333, 0.1]);

-- In text, arrays and maps.
print("at {b}", b.text());
vec2 array path = [[1, 2], [3, 4]];
path:inject([5, 6]);
print(path, #path);
vec2 map spots = [];
spots["home"] = [0, 0];
spots["work"] = b;
print(spots);
loop (vec2 v in path) {
    print(v:length());
}

-- Passed to and from methods.
method vec2 mid(vec2 x, vec2 y) {
    return (x + y) / 2;
}
print(mid([0, 0], [4, 2]));
end
