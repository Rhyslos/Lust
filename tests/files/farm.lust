// Helper for files.lust. Its own top-level code must not run when fetched.
state = [growing, ready];
state season = [spring, summer];

class Crop {
    has {
        string[name "wheat"];
        state is growing;
        season is spring;
    }

    method grow() {
        state is ready;
    }
}

object Barn {
    has {
        int[stored 0];
    }

    method store(Crop c) {
        stored = stored + 1;
        print("Stored " + c.name);
    }
}

do int harvestTime(int days) {
    give days * 2;
}

do secret() {
    print("not sent");
}

print("farm.lust's own code: this must not show up");

send Crop;
send Barn;
send harvestTime;
send state;
send season;

end
