// Mistakes with the built-in ui file. (UI programs can't run as tests, but their mistakes can be checked.)
fetch ui;

class Loud like Button {
    method clicked(int times) { }
}

class Shy like Label {
    method clicked() { }
}

object App like Window {
    has {
        Label[status nothing];
    }

    method build() {
        add("hello");
        label(42);
        status = new Label { colour "red" };
        add(new Input { text 5 });
    }
}

Window w = new Window { title "Two" };
App.open();
App:fly();
Button b = new Button;
b:clicked(1);

end
