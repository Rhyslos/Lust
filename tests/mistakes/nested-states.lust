state = [idle, fighting [attacking, blocking], walking []];
state mood = [calm, angry [red, purple]];

class Knight {
    has {
        state is fighting.dancing;
        mood is red;
    }
}

Knight k = new Knight;
k.state is blocking;
k.state is fighting.blocking.hard;
is k.state attacking? then { }
k.state is next(k.state);

end
