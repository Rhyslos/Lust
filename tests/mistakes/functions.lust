do int add(int a, int b) {
    give a + b;
}

do maybe(int n) {
    is n > 0? then {
        give n;
    }
}

do int half(int n) {
    is n > 0? then {
        give n / 2;
    }
}

do int loopsForever() {
    loop {
        give 1;
    }
}

