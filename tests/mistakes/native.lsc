-- What a native method takes and gives back has to be something Rust and Lust both know.
class Entity {
    has {
        int id = 0;
    }

    method tag(string map names) native;
    method int map hits() native;
    method say(string words) native
}

method int native() {
    return 1;
}

-- A state's option is checked like any other value.
state Clip = [Idle, Walk];
state Mood = [Calm];
method play(Clip clip) native;
play(Mood.Calm);
end
