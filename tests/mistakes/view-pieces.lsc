state Size = [Small, Large];

assembly Form {
    has {
        string name = "";
        int count = 0;
        bool ok = false;
        Size size = Size.Small;
        string pick = "";
    }

    view {
        column {
            switch count;
            switch name;
            number name;
            number ok;
            radio ok;
            radio pick;
            radio size in ["A"];
            radio name in [1, 2];
            switch ok 5;
            number count [min 10, max 2];
            number count [min -1, max -5.5];
            number count [min 0, max 9, from 1];
            slider count [min 0];
            icon "trsh";
            icon "not-an-icon-at-all";
            icon 5;
            icon;
            button "Delete" [icon "trash-3"];
            text "Hi" [icon "trash"];
            button;
            switch;
        }
    }
}
end
