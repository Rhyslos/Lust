-- Mistakes with events.
class Bag {
    has {
        int size = 1;
    }
}

event Hit(entity by, float damage);
event Hit(int twice);
event Carry(Bag bag, int array numbers);

component Health {
    has {
        float hp = 10;
    }

    on {
        Hit(entity by) {
            hp = hp - 1;
        }
        Hit(entity by, float damage) {
        }
        Missing() {
        }
        Carry(Bag bag, int array numbers) {
        }
    }

    method handle() {
    }
}

schema Plain {
    on {
        Hit(entity by, float damage) {
        }
    }
}

method go(entity e) {
    send Hit(e) to e;
    send Hit(e, "lots") to e;
    send Nope() to e;
    send Hit(e, 1) to 5;
    send Hit(e, 1);
    send Carry(new Bag, []) to e;
}
end
