-- Native methods take and give back states' options, as their full names: "Farmer.Walk".
fetch lua;

state Clip = [Idle, Farmer [Walk, Hoe]];

class Sprite {
    has {
        int id = 0;
    }

    method play(Clip clip) native;
    method Clip playing() native;
    method Clip array clips() native;
}

method Clip first() native;

lua {
    local now = "Idle"
    function Sprite_play(self, clip) now = clip print("play " .. clip) end
    function Sprite_playing(self) return now end
    function Sprite_clips(self) return { "Idle", "Farmer.Hoe", n = 2 } end
    LUST_NATIVES = { first = function() return "Farmer" end }
};

Sprite s = new Sprite { id = 1 };
s:play(Clip.Farmer.Walk);
Clip c = s:playing();
print(c);
is c == Clip.Farmer? then {
    print("a farmer clip");
}
is c === Clip.Farmer? then {
    print("never");
}
check s:playing() {
    when Farmer.Walk {
        print("walking");
    }
    when Farmer {
        print("farming");
    }
    when Idle {
        print("idle");
    }
}
print(s:clips());
print(first());
end
