-- A program in several files.
fetch "entities/player":[Player, Mood];
fetch "entities/world":[World, Weather];
get "helpers/maths":[clamp, twice];
fetch "entities/gear":Gear;
get "entities/gear":heavier;

-- This file's own describe; helpers/maths has a private one with the same name.
method string describe(int n) {
    return "main says " + n.text();
}

Player ada = new Player { name = "Ada" };
ada:hurt(30);
print(ada.hp);
print(ada.mood == Mood.Grumpy);
print(clamp(15, 0, 10));
print(twice(4));
print(describe(1));
print(ada);
World:tick();
World:tick();
print(World.day);
Weather today = Weather.Rainy;
print(today.mood == ada.mood, today.warmth, Weather.Sunny.mood);
-- A record from another file, copied as it's handed over.
Gear boots = new Gear { name = "boots" };
Gear more = heavier(boots);
print(boots, more.weight);
print(World.kit, Weather.Rainy.gear.weight);

end
