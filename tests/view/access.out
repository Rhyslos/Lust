  slider "Zoom" = "1" (0.5 to 2) (disabled)
  spin button "Count" = "2" (0 to 9, step 1)
  combo box "Fruit" = "Pear" (collapsed)
  date input "Due" = "" (collapsed)
  colour well "Tint" = "#3b82f6" (collapsed)
  progress bar "Loaded" = "30" (0 to 100)
  button "Delete note"
  button "Settings"
  button "star"
  button "Off" (disabled)
  image "Liked"
  image "bell"
  image "A sunset"
  image ""
  menu button "File" (collapsed)
  tab list
    tab "One" (selected)
    tab "Two"
  text "first tab"
  button "More" (collapsed)
  canvas "Chart"
    button "Red square"
  table "People", 3 rows, showing 1–3, 2 columns
    row
      column header "Name"
      column header "Age"
    row 1
      cell "Ada"
      cell "36"
    row 2
      cell "Bo"
      cell "7"
    row 3
      cell "Cy"
      cell "52"
  list, 2 rows, showing 1–2
    list item "Cat" 1
      text "Cat"
    list item "Dog" 2
      text "Dog"
  text "pet: "
