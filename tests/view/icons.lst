-- Icons: on their own, in buttons, coloured and sized, and one kept in a variable that changes.
assembly App {
    has {
        string log = "";
        Icon which = Icon.Star;
        bool dark = false;
    }

    view [title "Icons", width 420, height 260, dark dark] {
        column [gap 10, pad 16] {
            row [gap 8] {
                icon Icon.Trash [size 18, red6];
                icon Icon.House;
                icon Icon.ChevronRight [size 48];
                icon which [tip "Worked out"];
            }
            row [gap 8] {
                button "Delete" [icon Icon.Trash, red] { log = "deleted"; }
                button [icon Icon.Settings, tip "Settings"] { log = "settings"; }
                button "Next" [icon Icon.ArrowRight, small, disabled log == ""] { which = Icon.Heart; }
            }
            text log;
        }
    }
}

App:open();
end
