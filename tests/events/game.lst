-- Events: components send them to entities, and handle them with on.
method log(string words) native;

state Kind = [Fire, Ice];

event Hit(entity by, float damage, Kind kind);
event Damaged(float amount);
event Died();
event Pushed(vec3 push, rotation turn);
-- Heard only by Lust's own things: delivered after the engine's call into Lust is done.
event Scored(int points);

object Score {
    has {
        int total = 0;
    }

    on {
        Scored(int points) {
            total = total + points;
            log("score " + total.text());
        }
    }
}

component Health {
    has {
        float hp = 10;
    }

    on {
        Hit(entity by, float damage, Kind kind) {
            hp = hp - damage;
            log(me.text() + " Health: hit by " + by.text() + " for " + damage.text() + " " + kind.text());
            send Damaged(damage) to me;
            is hp <= 0? then {
                send Died() to me;
            }
        }

        Died() {
            send Scored(10);
            log(me.text() + " Health: died");
        }
    }
}

component Armor {
    has {
        int dents = 0;
    }

    on {
        Hit(entity by, float damage, Kind kind) {
            dents = dents + 1;
            log(me.text() + " Armor: dent " + dents.text());
        }

        Damaged(float amount) {
            log(me.text() + " Armor: took " + amount.text());
        }
    }
}

-- Entries in options: the shield blocks the first hit, then gives way; once broken, hits are ignored.
state Guard = [Up, Down [Cracked], Broken];

component Shield {
    has {
        float hp = 4;
        state = Guard.Up;
    }

    on {
        Hit(entity by, float damage, Kind kind) in Up {
            log("Shield: blocked " + kind.text() + ", now down");
            state = Guard.Down;
        }
        Hit(entity by, float damage, Kind kind) in Down {
            hp = hp - damage;
            log("Shield: took " + damage.text() + ", " + hp.text() + " left");
            is hp <= 0? then {
                state = Guard.Broken;
            }
        }
        Hit(entity by, float damage, Kind kind) in Down.Cracked {
            log("Shield: cracked, so it breaks");
            state = Guard.Broken;
        }
    }

    -- Methods in options: update chooses a body by the shield's state each tick.
    method update(float dt) in Broken {
        log("Shield: broken, can't block");
    }

    method update(float dt) {
    }
}

component Gun {
    has {
        entity target = nothing;
        float cooldown = 0;
    }

    method update(float dt) {
        cooldown = cooldown - dt;
        is cooldown <= 0 && target != nothing? then {
            cooldown = 1;
            send Hit(me, 6, Kind.Fire) to target;
        }
    }

    method int share(int ways) {
        int each = 12 / ways;
        return each;
    }

    on {
        Pushed(vec3 push, rotation turn) {
            log(me.text() + " Gun: pushed " + push.text() + " turned " + (turn * [1, 0, 0]).text());
        }
    }
}

pass log;
end
