-- The same game, edited while it runs.
get "parts/world":[log, nearest];

state Mode = [Single, Spread];

event Hit(entity by, float damage);

component Turret {
    has {
        float ammo = 10;
        float heat = 0;
        Mode mode = Mode.Single;
        entity target = nothing;
        float range = 20;
    }

    method update(float dt) {
        heat = heat + dt;
        log(me.text() + " turret v2: heat " + heat.text() + ", ammo " + ammo.text() + ", range " + range.text() + ", " + mode.text());
    }
}

component Radar {
    has {
        float sweep = 0;
    }
}
end
