-- The same game, edited while it runs.
get "parts/world":[log, nearest, positionOf];

state Mode = [Single, Spread];

event Hit(entity by, float damage, vec3 push);

component Turret {
    has {
        float ammo = 10;
        float heat = 0;
        Mode mode = Mode.Single;
        entity target = nothing;
        float range = 20;
        vec3 aim = [0, 0, 1];
    }

    method update(float dt) {
        heat = heat + dt;
        log(me.text() + " turret v2: heat " + heat.text() + ", ammo " + ammo.text() + ", range " + range.text() + ", " + mode.text() + ", aim " + aim.text());
    }
}

component Radar {
    has {
        float sweep = 0;
    }
}
end
