-- Events in options: a component's entries for Hit, chosen by its state when the engine hands
-- the event over. Methods in options: update and mend, chosen by its state when called. tests/events/game.lst has the same shield, built as a Rust library.
method log(string words) native;

event Hit(float damage);

-- Allowed moves: a Shield goes Up to Down, Down (Cracked too) to Broken, and Broken back to Up.
state Guard = [Up -> Down, Down [Cracked] -> Broken, Broken -> Up];

component Shield {
    has {
        float hp = 4;
        state = Guard.Up;
    }

    on {
        Hit(float damage) in Up {
            log("blocked, now down");
            state = Guard.Down;
        }
        Hit(float damage) in Down {
            hp = hp - damage;
            log("took {damage}, {hp} left");
            is hp <= 0? then {
                state = Guard.Broken;
            }
        }
        Hit(float damage) in Down.Cracked {
            log("cracked, so it breaks");
            state = Guard.Broken;
        }
    }

    -- Methods in options: update has a body for Down and one for the rest; mend only for Broken.
    method update(float dt) in Down {
        log("down, hp {hp}");
    }

    method update(float dt) {
    }

    method mend() in Broken {
        hp = 4;
        state = Guard.Up;
        log("mended");
    }

    -- Allowed moves: from Up, Broken isn't allowed, so this stops with WrongState there.
    method smash() {
        state = Guard.Broken;
        log("smashed");
    }
}

pass log;
end
