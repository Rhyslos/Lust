-- Inside a component, the entity's own abilities are called bare, and this is the entity.
fetch "solis/animators":FarmerAnimator;

component Hopper {
    has {
        float speed = 1;
        entity seen = nothing;
    }

    method update(float dt) {
        moveTo(position() + [speed * dt, 0, 0]);
        float velocity = velocity();
        log("velocity " + velocity.text());
        jump();
        this:jump();
        seen = me;
        log(this:position().text());
    }

    -- The component's own jump wins over the engine's; this:jump() still reaches the engine's.
    method jump() {
        log("the hopper's own jump");
    }
}

-- Something the engine's editor made for it, filled in by the engine.
component Farmer {
    has {
        FarmerAnimator anim;
    }

    method update(float dt) {
        anim:play("Walk");
    }
}

-- One for the whole game: ticked by the engine before the components, and saved.
object Clock {
    has {
        int day = 1;
        float hour = 23.5;
    }

    method update(float dt) {
        hour += dt;
        is hour >= 24? then {
            hour = hour - 24;
            day += 1;
        }
    }
}

-- Not passed, so it's only this file's: the engine neither ticks nor saves it.
object Weather {
    has {
        int rain = 0;
    }

    method update(float dt) {
        rain += 1;
    }
}

method log(string words) native;

pass Clock;
end
